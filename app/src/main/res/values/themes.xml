<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The app draws edge-to-edge and owns its own dark surface, so the platform
      window background must match CyberPalette.bg to avoid a white flash on cold
      start. Theme.MyApplication is also the parent for the system splash screen.
    -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/cyber_window_bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
