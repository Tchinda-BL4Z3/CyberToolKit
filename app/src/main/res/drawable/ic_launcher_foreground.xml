<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground. The shield sits inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Scale the 108x108 artwork down into the 66dp safe zone.

      The pivot is the centre, so NO translation is needed. There used to be a
      translateX/translateY of 20.52 here, which is 54 * (1 - 0.62): the
      compensation you need when the pivot is the origin. Combined with
      pivotX/pivotY = 54 it shifted the shield 20.5 units right and down, pushing
      it off-centre and out of the safe zone.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.62"
        android:scaleY="0.62">

        <path
            android:fillColor="#10B981"
            android:pathData="M54,25.5 L77,35.5 L77,54.5 C77,69 66.5,79.5 54,85.5 C41.5,79.5 31,69 31,54.5 L31,35.5 Z" />
        <path
            android:fillColor="#0B0F19"
            android:pathData="M54,31.5 L71,38.9 L71,54.3 C71,65.4 63.4,73.9 54,78.9 C44.6,73.9 37,65.4 37,54.3 L37,38.9 Z" />
        <path
            android:strokeColor="#10B981"
            android:strokeWidth="3.4"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M47,52 L47,47.5 A7,7 0 0 1 61,47.5 L61,52" />
        <path
            android:fillColor="#10B981"
            android:pathData="M44.6,52 L63.4,52 A2.4,2.4 0 0 1 65.8,54.4 L65.8,66.6 A2.4,2.4 0 0 1 63.4,69 L44.6,69 A2.4,2.4 0 0 1 42.2,66.6 L42.2,54.4 A2.4,2.4 0 0 1 44.6,52 Z" />
        <path
            android:fillColor="#0B0F19"
            android:pathData="M52.1,57.4 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z" />
        <path
            android:fillColor="#0B0F19"
            android:pathData="M52.7,59.2 L54.1,59.2 L55.3,66.4 L51.5,66.4 Z" />
    </group>
</vector>
