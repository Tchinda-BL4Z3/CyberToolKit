<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET is declared for exactly one feature: the opt-in SSH client, which
      connects to lab machines the operator owns and has credentials for.

      Nothing else in the app opens a socket. The offline modules (encoder,
      crypto, lock, the simulated lab) never touch the network, and the SSH client
      refuses to run until the operator explicitly enables it in Settings.

      This is declared in the manifest rather than requested at runtime because
      Android has no runtime consent prompt for INTERNET: the user's decision point
      is the in-app opt-in switch, and the Play Console data safety form must
      declare network use accordingly.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        android:usesCleartextTraffic="false"
        tools:targetApi="q">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize"
            tools:targetApi="33">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
