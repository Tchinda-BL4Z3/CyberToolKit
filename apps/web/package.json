{
  "name": "project-security-scanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "predev": "npm run wasm",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run wasm",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "cargo test --workspace",
    "test:web": "tsc --noEmit && vite build",
    "test:smoke": "node scripts/smoke.mjs",
    "pretest:smoke": "npm run wasm",
    "wasm": "cargo build -p sensitive-wasm --release --target wasm32-unknown-unknown && mkdir -p src/wasm && cp ../../target/wasm32-unknown-unknown/release/sensitive_wasm.wasm src/wasm/sensitive_wasm.wasm",
    "cli": "cargo run -p sensitive-cli --release --"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
